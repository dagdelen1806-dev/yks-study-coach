# Copy this file to .env locally and fill in real values.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
JWT_SECRET=replace-with-a-long-random-secret
# BOŞ BIRAKMA — gerçek bir Manus app id olması gerekmiyor ama dolu olmalı:
# sunucu bunu her oturum jetonunun appId alanına yazar ve doğrulama bunun
# dolu olmasını şart koşar; boş olursa giriş "başarılı" görünür ama oturum
# hiçbir zaman doğrulanamaz.
VITE_APP_ID=yks-study-coach-local
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Manus dışı deploy: OpenAI uyumlu yapay zekâ sağlayıcısı (fotoğraf okuma / AI). Tanımlıysa Forge yerine kullanılır.
LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
NODE_ENV=development
# Yerel ad+şifre girişini (server/_core/devAuth.ts) production'da da açar.
# Development'ta zaten her zaman açık, bu satır yalnızca production için.
# Manus platformu dışında bağımsız bir deploy'da (Vercel, Railway, ...) bu
# GEREKLİ — aksi halde giriş sayfası hiç çalışmaz. Kayıt olan her hesap yine
# de admin onayı bekler (approvalStatus), rastgele biri kayıt olsa da panele
# giremez — ama üye adı/şifre alanını herkes deneyebilir, bunu bilerek aç.
ALLOW_LOCAL_AUTH=true

# Admin hesap(lar)ı — virgülle ayrılmış e-posta/telefon listesi. E-postayla
# kayıt olan hesap, adresini doğruladığı anda admin olur (doğrulanmadan asla).
# Telefon için doğrulama yok: telefonla admin tanımlarsan deploy'dan hemen
# sonra o numarayla kayıt ol, yoksa numarayı bilen biri önce davranabilir.
ADMIN_LOGINS=

# E-posta doğrulaması (bkz. server/_core/emailVerification.ts, mailer.ts)
# APP_URL: doğrulama linklerinin kök adresi. Production'da MUTLAKA https ile
# gerçek alan adın (ör. https://yks-study-coach.vercel.app). Yerelde boş kalabilir.
APP_URL=
# Mail sağlayıcısı — BİRİNİ doldur (ikisi birden doluysa Brevo kullanılır).
# İkisi de boşsa: yerelde mail gönderilmez, doğrulama linki sunucu konsoluna
# yazılır; production'da gönderim hata verir.
#  - Brevo (kendi alan adın yoksa önerilen): brevo.com → SMTP & API → API Keys.
#    Senders bölümünde MAIL_FROM'daki adresi doğrula (ör. Gmail adresin).
BREVO_API_KEY=
#  - Resend: yalnızca Resend'de doğrulanmış kendi alan adınla herkese gönderir.
RESEND_API_KEY=
# Gönderen: "Ad <adres>" ya da yalnızca adres. Brevo'da doğrulanmış gönderen,
# Resend'de doğrulanmış alan adından bir adres olmalı.
MAIL_FROM=Pusula YKS <ben@gmail.com>

# Client-side (VITE_*) counterparts of the Manus OAuth/Forge values above —
# only ever injected by the hosted Manus platform itself. Leave these blank
# for a standalone deployment (this repo, Vercel, Railway, etc.): the client
# gracefully falls back to the local sign-in dialog / a disabled Map widget
# when they're unset — this is intentional, not a missing-config bug (bkz.
# client/src/const.ts startLogin, client/src/components/Map.tsx — the latter
# is unused/dead code in this deployment).
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Resource Catalog (FAZ 4A) — all optional, sensible defaults in
# server/resourceCatalog/config.ts. Uncomment to override. See
# docs/resource-catalog/OPERATIONS.md.
# RESOURCE_CATALOG_AI_ENABLED=false
# RESOURCE_CATALOG_DIFFICULTY_EASY_MAX=39
# RESOURCE_CATALOG_DIFFICULTY_MEDIUM_MAX=69
# RESOURCE_CATALOG_REVIEW_CONFIDENCE_THRESHOLD=0.55

# Subscription / Payment (PHASE 2) — see docs/subscription/SUBSCRIPTION-ARCHITECTURE.md.
# "mock" (sandbox, default) | "apple" | "google" | a real web provider's name once one is integrated.
PAYMENT_PROVIDER=mock
# Only used by the sandbox MockPaymentProvider's webhook HMAC signature — never a real secret.
PAYMENT_MOCK_WEBHOOK_SECRET=
# Apple App Store Server API — CONFIG_REQUIRED, no real values exist yet.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=
# Google Play Developer API — CONFIG_REQUIRED, no real values exist yet.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# Reserved for a future real web payment provider's webhook signature secret.
WEBHOOK_INGEST_SECRET=

# Vercel deployment only — protects /api/cron/resource-catalog-sync from
# being triggered by anyone other than Vercel Cron. Set the same random
# value here and in the Vercel project's env vars; Vercel Cron automatically
# sends it as `Authorization: Bearer $CRON_SECRET`. See VERCEL-DEPLOY.md.
CRON_SECRET=
